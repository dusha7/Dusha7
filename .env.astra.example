# ---- Astra Telegram bot ----
# Copy the values into Vercel → Project → Settings → Environment Variables.

# From @BotFather
ASTRA_BOT_TOKEN=123456:ABC-your-telegram-bot-token

# From console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# From Upstash Redis (Details → REST API)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Optional: any random string. If set, Telegram signs every webhook call and
# the handler rejects anything without it. Register it via scripts/set-webhook.js.
ASTRA_WEBHOOK_SECRET=

# Optional: switch model for maximum speed (default claude-opus-5).
# ASTRA_MODEL=claude-haiku-4-5
